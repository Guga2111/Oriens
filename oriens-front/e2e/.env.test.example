# Credenciais de teste do Playwright — NUNCA commitar e2e/.env.test.
#
# O e2e/global-setup.ts cria uma conta nova com e-mail @oriens.test e senha
# aleatórias a cada execução, e as expõe por variáveis de ambiente. Preencha
# os campos abaixo apenas se quiser fixar valores locais (opcionais).
E2E_EMAIL=
E2E_PASSWORD=

# Endereços dos serviços locais (defaults já usados pelo setup).
E2E_BASE_URL=http://localhost:5173
E2E_API_BASE_URL=http://localhost:8080
