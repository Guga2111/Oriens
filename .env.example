# Copie este arquivo para .env na raiz do repo.
# ATENCAO: preencha com valores REAIS apenas no .env (que e git-ignorado).
# NUNCA coloque segredos reais neste .env.example - apenas placeholders.
#
# O Compose local lê este .env. No CI, o workflow de deploy grava o .env da VPS.

# ---------------------------------------------------------------------------
# Banco de dados Supabase (connection pooler)
# Copie do painel Supabase > Project Settings > Database > Connection string
# ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres?prepareThreshold=0
DB_USER=postgres.seu-project-ref
DB_PASSWORD=troque-por-sua-senha-supabase

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Porta do proxy no loopback da VPS (o container escuta em 8080).
API_PORT=8080

# Deploy: habilitar o vhost versionado após o provisionamento autorizado do instalador.
ORIENS_NGINX_APPLY=false

# Deploy: par opcional de SHAs completos candidata:anterior, aprovado no ensaio.
ROLLBACK_COMPATIBLE_PAIR=

# Obrigatória; gerar chave aleatória de pelo menos 64 bytes e guardar fora do Git.
# Rotacionar antes da instalação limpa para invalidar sessões anteriores.
JWT_SECRET=

# MCP P0/P1: disabled until compatibility/security gates are evidenced.
ORIENS_MCP_ENABLED=false
# Trusted public origins, no paths/query; HTTPS except 127.0.0.1 isolated proof.
ORIENS_MCP_ISSUER=https://api.example.invalid
ORIENS_MCP_FRONTEND=https://app.example.invalid
# Supply using the secret manager, stable across instances; never commit live values.
ORIENS_MCP_ENCRYPTION_PASSWORD=
ORIENS_MCP_ENCRYPTION_SALT=
# Explicit registered loopback callback paths. Only an IP loopback port may vary.
ORIENS_MCP_CODEX_REDIRECTS=http://127.0.0.1/callback
ORIENS_MCP_CLAUDE_REDIRECTS=http://localhost:8765/callback
