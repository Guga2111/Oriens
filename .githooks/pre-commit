#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
scanner="${GITLEAKS_BINARY:-gitleaks}"
if ! command -v "$scanner" >/dev/null; then
  echo "Instale Gitleaks antes de usar o pre-commit. Veja docs/guides/pre-commit.md." >&2
  exit 1
fi

scratch="$(mktemp -d)"
trap 'rm -rf -- "$scratch"' EXIT
# The scanner uses Git's index, including partial stages and the staged policy.
if ! git show :.gitleaks.toml > "$scratch/.gitleaks.toml" 2>/dev/null ||
   ! git show :.gitleaksignore > "$scratch/.gitleaksignore" 2>/dev/null; then
  echo "Política Gitleaks ausente no staged." >&2
  exit 1
fi

if "$scanner" git . --staged --config "$scratch/.gitleaks.toml" \
    --gitleaks-ignore-path "$scratch/.gitleaksignore" --redact=100 \
    --ignore-gitleaks-allow --no-banner --no-color --exit-code=3 >/dev/null 2>&1; then
  :
else
  status=$?
  if [[ "$status" -eq 3 ]]; then
    echo "Segredo suspeito no staged. Revise o diff local em privado." >&2
  else
    echo "A varredura Gitleaks falhou. Confira a instalação e a política." >&2
  fi
  exit "$status"
fi

git diff --cached --name-only --diff-filter=ACMT --no-renames -z > "$scratch/added"
git diff --cached --name-only --no-renames -z > "$scratch/changed"

client_paths=()
client_changed=false
api_changed=false
while IFS= read -r -d '' path; do
  case "$path" in
    apps/client/src/*.ts|apps/client/src/*.tsx) client_paths+=("./${path#apps/client/}") ;;
  esac
done < "$scratch/added"
while IFS= read -r -d '' path; do
  case "$path" in
    apps/client/src/*|apps/client/package*.json|apps/client/*config.*|apps/client/e2e/*) client_changed=true ;;
    apps/api/src/*|apps/api/pom.xml|apps/api/mvnw|apps/api/.mvn/*) api_changed=true ;;
  esac
done < "$scratch/changed"

if "$client_changed"; then
  if [[ ! -x apps/client/node_modules/.bin/eslint || ! -x apps/client/node_modules/.bin/vitest ]]; then
    echo "Execute npm ci em apps/client antes de usar o pre-commit." >&2
    exit 1
  fi
  make lint
  if [[ "${#client_paths[@]}" -gt 0 ]]; then
    (cd apps/client && npm exec -- vitest related --run --passWithNoTests -- "${client_paths[@]}")
  else
    (cd apps/client && npm test -- src/__tests__/cn-tokens.test.ts)
  fi
fi

if "$api_changed"; then
  (cd apps/api && ./mvnw -B test \
    -Dtest=CyclomaticComplexityTest,JwtConfigurationTest,ImageUploadsTest,TaskDescriptionCodecTest)
fi
